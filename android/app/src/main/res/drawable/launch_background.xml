<?xml version="1.0" encoding="utf-8"?>
<!-- Native pre-Flutter launch screen: solid E-LIKAS navy with the real
     logo centered, so there's no default-white/Flutter-mark flash
     before lib/app/splash/splash_page.dart takes over on the engine's
     first frame. Uses the exact same logo asset
     (res/drawable-nodpi/ic_launcher_logo.png, copied unmodified from
     assets/images/elikas_logo.png) as that Flutter splash screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/elikas_navy" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_launcher_logo" />
    </item>
</layer-list>
