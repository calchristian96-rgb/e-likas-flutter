<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8.0+ (API 26+) adaptive icon. Devices below 26 fall back to
     the legacy per-density res/mipmap-*/ic_launcher.png files, which
     were regenerated with the same navy background + E-LIKAS logo so
     the icon looks identical on old and new Android versions alike. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
